{
  "name": "paperxcel",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first AI workspace for reading, organizing, and comparing research papers.",
  "main": "./out/main/index.js",
  "author": "PaperXcel",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/Luedong-div/PaperXcel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Luedong-div/PaperXcel.git"
  },
  "bugs": {
    "url": "https://github.com/Luedong-div/PaperXcel/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-dev.mjs",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"electron.vite.config.ts\"",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && node tests/electron-smoke.mjs",
    "test:citation-graph": "npm run build && node tests/citation-graph-smoke.mjs",
    "test:packaged": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-packaged.ps1",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@thednp/dommatrix": "^3.0.4",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@xyflow/react": "^12.11.2",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-store": "^11.0.2",
    "electron-vite": "^5.0.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.10.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.24.0",
    "openai": "^6.46.0",
    "pdfjs-dist": "^6.1.200",
    "playwright": "^1.61.1",
    "prettier": "3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "cn.paperxcel.desktop",
    "productName": "PaperXcel",
    "asar": true,
    "compression": "maximum",
    "afterPack": "scripts/after-pack.cjs",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "release"
    },
    "extraFiles": [
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "README.md",
        "to": "README.md"
      }
    ],
    "files": [
      "out/**/*",
      "package.json",
      "!models/**/*"
    ],
    "win": {
      "icon": "public/paperxcel.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0"
  }
}
